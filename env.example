# Firebase Configuration
# Copy this file to .env.local and replace the placeholder values with your actual Firebase project configuration
# Get these values from your Firebase project settings at https://console.firebase.google.com/

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firestore database id. Only needs setting for a non-default database; leave it
# as (default) unless your project uses a named database.
NEXT_PUBLIC_FIREBASE_DATABASE_ID=(default)

# ---------------------------------------------------------------------------
# Mark (the Tasky manager agent) — server only
# ---------------------------------------------------------------------------
# None of these may use the NEXT_PUBLIC_ prefix: Mark's provider modules are
# server-only and must never be bundled for the browser. At least one provider
# key is required for Mark to run at all; never commit real values.

# Provider order. `nvidia` (default) or `groq`. The other is used as a fallback,
# and only for recoverable failures — timeouts, rate limits, unavailability.
# Never for a policy, RBAC, approval or scope failure.
MARK_LLM_PROVIDER=nvidia

# NVIDIA (primary where configured)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=30000

# Groq (fallback where configured)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=30000

# Transient-failure retries. Hosted inference endpoints intermittently return
# 5xx/429 under load; the same request usually succeeds moments later, so each
# provider is retried with exponential backoff before Mark falls back. Only
# recoverable failures are retried — never a policy, RBAC, approval, or scope
# failure. Timeouts (which already consumed a full request budget) retry once.
MARK_PROVIDER_MAX_ATTEMPTS=3

# Mark policy limits (defaults shown)
# How long an approval card stays usable, in minutes (1-60, default 5). Short on
# purpose: an approval is for one specific operation, and a card left open on a
# screen should not still be valid hours later.
MARK_APPROVAL_TTL_MINUTES=5
MARK_MAX_TOOL_STEPS=8
MARK_MAX_CONTEXT_CHARS=60000

# Bulk-operation thresholds. BULK is where a write starts needing review,
# HIGH_RISK escalates the warning, and MAX is a hard ceiling — an operation
# affecting more than this many resources is refused outright rather than
# approved.
MARK_BULK_OPERATION_THRESHOLD=5
MARK_HIGH_RISK_OPERATION_THRESHOLD=25
MARK_MAX_RESOURCES_PER_OPERATION=200

# Whether policy denial reasons are surfaced verbatim. Off by default: a denial's
# reason can hint at the existence of resources the user cannot see, so the
# default is to report it to the user only.
MARK_EXPOSE_DENIALS=false
